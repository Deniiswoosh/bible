# Flask and database
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@localhost:5432/bible_accountability
FLASK_DEBUG=false
PORT=5000
SESSION_COOKIE_SECURE=true
# Set SESSION_COOKIE_SECURE=false in your local .env when using plain HTTP.

# Required when running the seed-db command
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_MEMBER_PASSWORD=replace-with-a-strong-member-password

# Password reset controls
DAILY_DEADLINE=23:59
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=900
PASSWORD_RESET_IP_LIMIT=5
PASSWORD_RESET_IP_WINDOW_SECONDS=3600

# SMTP email delivery
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=no-reply@example.com

# Twilio SMS delivery
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15005550006
